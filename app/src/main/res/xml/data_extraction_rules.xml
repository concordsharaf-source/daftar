<?xml version="1.0" encoding="utf-8"?>
<!--
  قواعد أندرويد 12+ (API 31+): منع النسخ السحابي ونقل الجهاز لبيانات التطبيق.
  «دفتر» يحتفظ بملاحظاته في قاعدة بيانات غير مشفّرة محليًا، ولذلك يجب ألا
  تُنسخ تلقائيًا إلى Google Drive أو إلى جهاز جديد عند النقل. النسخ الاحتياطي
  المتاح للمستخدم هو الذي يُنشئه هو من داخل التطبيق (ZIP يشمل الصور).
  القواعد افتراضيًا «اسمح بكل شيء»، لذلك نستثني كل المجالات صراحةً.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
